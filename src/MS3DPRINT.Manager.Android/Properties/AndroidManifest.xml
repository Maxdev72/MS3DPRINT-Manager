<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <application android:label="MS3DPRINT Compagnon" android:allowBackup="false" android:supportsRtl="true">
    <!-- The camera app writes the photo of the receipt here; only this app can read the cache folder it points to. -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="fr.ms3dprint.compagnon.fileprovider"
              android:exported="false"
              android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
  <queries>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
  </queries>
</manifest>
