<Window x:Class="MS3DPRINT.Manager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire MS3DPRINT" Width="620" Height="700" MinWidth="470" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ActionCardButton" TargetType="Button">
            <Setter Property="Height" Value="120" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#D8E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF3FA" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#F3AF35" />
                    <Setter Property="BorderThickness" Value="3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="28,24">
            <StackPanel>
                <TextBlock Text="Gestionnaire MS3DPRINT" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Organisation des dossiers Nextcloud" Margin="0,6,0,0" FontSize="14" Foreground="#D7E5F0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="#D9E1E8" BorderThickness="0,1,0,0" Padding="28,14" Background="White">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,23">
                <TextBlock Text="Dossier de stockage" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StorageRoot}" Margin="0,6,0,22" TextWrapping="Wrap" />
                <TextBlock Text="Actions rapides" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource ActionCardButton}" Click="NewClient_Click">
                        <StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Nouveau client" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Créer le dossier et le code client." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewProject_Click">
                        <StackPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Nouveau projet" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Créer une référence et son arborescence." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewModel_Click">
                        <StackPanel><TextBlock Text="&#xF1C5;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Nouveau modèle 3D" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Organiser les sources, STEP et STL." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewProduct_Click">
                        <StackPanel><TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Nouveau produit" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Préparer un produit MS3DPRINT." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewSupplier_Click">
                        <StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Nouveau fournisseur" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Centraliser les contacts et tarifs." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="OpenRoot_Click">
                        <StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Ouvrir les dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Afficher MS3DPRINT dans l’Explorateur." TextWrapping="Wrap" Foreground="#52657A" /></StackPanel>
                    </Button>
                </UniformGrid>
                <Button Content="&#xE895;  Vérifier l’arborescence" FontFamily="Segoe UI" Margin="0,0,14,8" Click="VerifyStructure_Click" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
