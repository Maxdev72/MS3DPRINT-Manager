<Window x:Class="MS3DPRINT.Manager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MS3DPRINT.Manager.App.Controls"
        Title="Gestionnaire MS3DPRINT" Width="700" Height="760" MinWidth="390" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ActionCardButton" TargetType="Button">
            <Setter Property="MinHeight" Value="130" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F3AF35" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SecondaryBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource NavigationHoverBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource HeaderMutedBrush}" /><Setter Property="Opacity" Value="0.72" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="174" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource HeaderBrush}" Padding="12,22">
            <StackPanel>
                <TextBlock Text="MS3DPRINT" Foreground="{DynamicResource HeaderTextBrush}" FontWeight="SemiBold" FontSize="17" Margin="10,0,0,22" />
                <Button Style="{StaticResource NavigationButton}" Content="Tableau de bord" Click="Dashboard_Click" />
                <Button Style="{StaticResource NavigationButton}" Content="Clients" Click="Clients_Click" Margin="0,5,0,0" />
                <Button Style="{StaticResource NavigationButton}" Content="Projets" Click="Projects_Click" Margin="0,5,0,0" />
                <Button Style="{StaticResource NavigationButton}" Content="Modèles 3D" Click="Models_Click" Margin="0,5,0,0" />
                <Button Style="{StaticResource NavigationButton}" Content="Produits" Click="Products_Click" Margin="0,5,0,0" />
                <Button Style="{StaticResource NavigationButton}" Content="Fournisseurs" Click="Suppliers_Click" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="28,24">
            <StackPanel>
                <TextBlock Text="Gestionnaire MS3DPRINT" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" />
                <TextBlock Text="Organisation des dossiers Nextcloud" Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource HeaderMutedBrush}" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14" Background="{DynamicResource SurfaceBrush}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <ContentControl x:Name="PageHost">
        <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,23">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dossier de stockage" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StorageRoot}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Vérifier" Style="{StaticResource SecondaryActionButton}"
                            VerticalAlignment="Center" Margin="24,0,0,0" Click="VerifyStructure_Click" />
                </Grid>
                <DockPanel Margin="0,0,0,12"><TextBlock Text="Vue d’ensemble" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" FontSize="17" DockPanel.Dock="Left" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="DashboardLoadingText" Text="Actualisation…" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0" /><Button Content="Actualiser" Style="{StaticResource SecondaryActionButton}" Click="DashboardRefresh_Click" /></StackPanel></DockPanel>
                <TextBlock x:Name="DashboardErrorText" Visibility="Collapsed" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,10" />
                <controls:ResponsiveCardPanel MaxColumns="5" MinimumItemWidth="125" ItemHeightRatio="0.62" Gap="10" Margin="0,0,0,24">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="CLIENTS" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DashboardClientsCount" Text="{Binding DashboardClientsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="PROJETS" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DashboardProjectsCount" Text="{Binding DashboardProjectsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="DEVIS" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DashboardQuotesCount" Text="{Binding DashboardQuotesCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="EN COURS" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DashboardInProgressCount" Text="{Binding DashboardInProgressCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="TERMINÉS" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock x:Name="DashboardCompletedCount" Text="{Binding DashboardCompletedCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                </controls:ResponsiveCardPanel>
                <TextBlock Text="Actions rapides" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14" />
                <controls:ResponsiveCardPanel MaxColumns="4" MinimumItemWidth="240" ItemHeightRatio="0.42" Gap="14">
                    <Button Style="{StaticResource ActionCardButton}" Click="NewClient_Click">
                        <StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Nouveau client" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Créer le dossier et le code client." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="Settings_Click"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Paramètres" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Choisir le thème de l’application." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel></Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewProject_Click">
                        <StackPanel><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Nouveau projet" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Créer une référence et son arborescence." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewModel_Click">
                        <StackPanel><TextBlock Text="&#xF1C5;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Nouveau modèle 3D" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Organiser les sources, STEP et STL." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewProduct_Click">
                        <StackPanel><TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Nouveau produit" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Préparer un produit MS3DPRINT." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="NewSupplier_Click">
                        <StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Nouveau fournisseur" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Centraliser les contacts et tarifs." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="OpenRoot_Click">
                        <StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Ouvrir les dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Afficher MS3DPRINT dans l’Explorateur." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardButton}" Click="ClassifyFile_Click">
                        <StackPanel><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="27" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Classer un fichier" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="Déplacer et rattacher un fichier à un projet." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
                    </Button>
                </controls:ResponsiveCardPanel>
            </StackPanel>
        </ScrollViewer>
        </ContentControl>
    </DockPanel>
    </Grid>
</Window>
