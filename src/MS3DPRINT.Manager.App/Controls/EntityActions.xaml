<UserControl x:Class="MS3DPRINT.Manager.App.Controls.EntityActions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,14,0,4">
        <TextBlock Text="Gestion de l’élément" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
        <WrapPanel>
            <Button x:Name="EditButton" Content="Modifier la fiche" Click="Edit_Click" Margin="0,0,8,8" Visibility="Collapsed" />
            <Button Content="Renommer…" Click="Rename_Click" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,8" />
            <Button Content="Déplacer…" Click="Move_Click" Style="{DynamicResource ToolbarButton}" Margin="0,0,8,8" />
            <Button Content="Supprimer…" Click="Trash_Click" Style="{DynamicResource ToolbarDangerButton}" Margin="0,0,8,8" />
        </WrapPanel>
    </StackPanel>
</UserControl>
