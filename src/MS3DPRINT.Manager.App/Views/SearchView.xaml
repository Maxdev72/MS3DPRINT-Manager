<UserControl x:Class="MS3DPRINT.Manager.App.Views.SearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,23">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Recherche globale" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="Retrouver un client, un projet ou un fichier du stockage." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" MinWidth="100" KeyDown="QueryBox_KeyDown" ToolTip="Nom, référence ou code client" AutomationProperties.Name="Rechercher dans MS3DPRINT" />
            <Button Grid.Column="1" Content="Rechercher" Click="Search_Click" Margin="10,0,0,0" MinWidth="110" />
        </Grid>
        <TextBlock x:Name="MessageText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" Text="Saisissez un mot puis lancez la recherche." TextWrapping="Wrap" Margin="0,0,0,12" />
        <ListView x:Name="ResultsList" Grid.Row="3" SelectionChanged="ResultsList_SelectionChanged" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate><Border Padding="14,11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel></Border></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
