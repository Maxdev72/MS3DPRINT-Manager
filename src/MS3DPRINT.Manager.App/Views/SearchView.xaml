<UserControl x:Class="MS3DPRINT.Manager.App.Views.SearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,23">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Recherche globale" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="Retrouver un client, un projet ou un fichier du stockage." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" MinWidth="100" KeyDown="QueryBox_KeyDown" ToolTip="Nom, référence ou code client" AutomationProperties.Name="Rechercher dans MS3DPRINT" />
            <Button Grid.Column="1" Content="Rechercher" Click="Search_Click" Margin="10,0,0,0" MinWidth="110" />
        </Grid>
        <TextBlock x:Name="MessageText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" Text="Saisissez un mot puis lancez la recherche." TextWrapping="Wrap" Margin="0,0,0,12" />
        <DockPanel Grid.Row="3">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4"><Button x:Name="OpenButton" Content="Ouvrir" Click="Open_Click" IsEnabled="False" Margin="0,0,8,8" />
            </WrapPanel>
            <ListView x:Name="ResultsList" SelectionMode="Single" SelectionChanged="ResultsList_SelectionChanged"><ListView.View><GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="Nom" Width="330" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Emplacement" Width="500" DisplayMemberBinding="{Binding Path}" />
            </GridView></ListView.View></ListView>
        </DockPanel>
    </Grid>
</UserControl>
