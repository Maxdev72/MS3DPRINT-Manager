<Window x:Class="MS3DPRINT.Manager.App.Views.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau projet client" Width="560" Height="540" MinWidth="390" MinHeight="400"
        Style="{DynamicResource MaterialDesignWindow}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Closing="Window_Closing">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" />
                <Button Content="Créer le projet" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Créer un projet client" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="La référence est calculée à partir des projets présents dans le dossier client." Margin="0,7,0,20" TextWrapping="Wrap" />
                <TextBlock Text="Client" FontWeight="SemiBold" />
                <ComboBox x:Name="ClientBox" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Margin="0,6,0,14" />
                <TextBlock Text="Code client" FontWeight="SemiBold" />
                <TextBox x:Name="CodeBox" Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CodeIsReadOnly}" Margin="0,6,0,5" />
                <TextBlock Text="{Binding CodeLoadError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Si aucun code n’est enregistré, saisissez-le. Sa sauvegarde sera confirmée avant création."
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                <TextBlock Text="Année" FontWeight="SemiBold" />
                <TextBox x:Name="YearBox" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Margin="0,6,0,14" />
                <TextBlock Text="Nom du projet" FontWeight="SemiBold" />
                <TextBox x:Name="ProjectNameBox" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" />
                <TextBlock Text="Référence du dossier" FontWeight="SemiBold" />
                <TextBox Text="{Binding ReferencePreview, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource ReadOnlyInputBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
