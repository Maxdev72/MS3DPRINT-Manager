<UserControl Foreground="{DynamicResource TextBrush}" x:Class="MS3DPRINT.Manager.App.Views.LegacyEntityDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><Button Content="← Retour" Click="Back_Click" HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}" /><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4" /><TextBlock x:Name="FolderPathText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" /></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,4"><TextBlock Text="Fiche à compléter · Vos fichiers sont accessibles." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,8" /><Button Content="Compléter la fiche…" Click="Complete_Click" Margin="0,0,8,8" />
            <Button Content="Renommer…" IsEnabled="False" ToolTip="Complétez la fiche avant de renommer ce dossier." ToolTipService.ShowOnDisabled="True" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" />
            <Button Content="Déplacer…" IsEnabled="False" ToolTip="Complétez la fiche avant de déplacer ce dossier." ToolTipService.ShowOnDisabled="True" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" />
            <Button Content="Supprimer…" Click="Trash_Click" Foreground="{DynamicResource ErrorBrush}" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" />
        </WrapPanel>
        <TabControl x:Name="DetailTabs" Grid.Row="2" SelectedIndex="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Fichiers" Width="150"><ContentControl x:Name="FilesHost" Margin="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></TabItem>
            <TabItem Header="Informations" Width="150"><TextBlock Margin="16" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Ce dossier ne possède pas encore de fiche. Utilisez « Compléter la fiche » pour ajouter ses informations. La consultation des fichiers ne modifie pas la fiche." /></TabItem>
        </TabControl>
    </Grid>
</UserControl>
