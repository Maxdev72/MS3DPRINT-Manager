<UserControl x:Class="MS3DPRINT.Manager.App.Views.CollectionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,23">
        <Button Content="← Retour" Click="Back_Click" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,4" />
        <TextBlock Text="Dossier de travail" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="Fichiers et sous-dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentDirectory}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Content="Remonter" Click="Up_Click" IsEnabled="{Binding CanGoUp}" Margin="10,0,0,0" /></Grid>
        <ListView x:Name="FilesList" ItemsSource="{Binding FileEntries}" SelectionChanged="File_SelectionChanged" MinHeight="220" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"><ListView.ItemTemplate><DataTemplate><Border Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding Name}" /><TextBlock Grid.Column="2" Text="{Binding Length}" Foreground="{DynamicResource MutedBrush}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel></ScrollViewer>
</UserControl>
