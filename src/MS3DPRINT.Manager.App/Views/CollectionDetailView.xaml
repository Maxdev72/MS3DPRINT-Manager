<UserControl x:Class="MS3DPRINT.Manager.App.Views.CollectionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MS3DPRINT.Manager.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,23">
        <Button Content="← Retour" Click="Back_Click" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
        <controls:EntityActions x:Name="ManagementActions" />
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,4" />
        <TextBlock Text="Dossier de travail" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,8" />
        <StackPanel Margin="0,4,0,8">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsSupplier}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Coordonnées fournisseur" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Contact}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Address}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Phone}" /><TextBlock Text="{Binding Email}" /><TextBlock Text="{Binding Website}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="Fichiers et sous-dossiers" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
        <StackPanel Margin="0,0,0,8">
            <TextBlock x:Name="CurrentPathText" Text="{Binding CurrentDirectory}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip="{Binding CurrentDirectory}" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Remonter" Click="Up_Click" IsEnabled="{Binding CanGoUp}" Margin="0,0,10,8" />
                <Button x:Name="Preview3DButton" Content="Visualiser en 3D" Click="Preview3D_Click" IsEnabled="False" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
        <WrapPanel x:Name="FileActionsHost" Margin="0,0,0,8" />
        <ListView x:Name="FilesList" ItemsSource="{Binding FileEntries}" SelectionChanged="File_SelectionChanged" MinHeight="220" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"><ListView.ItemTemplate><DataTemplate><Border Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding Name}" /><TextBlock Grid.Column="2" Text="{Binding Length}" Foreground="{DynamicResource MutedBrush}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel></ScrollViewer>
</UserControl>
