<Window x:Class="MS3DPRINT.Manager.App.Views.CreateTrackedProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau projet" Width="560" Height="650" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#C73A3A" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" Background="#64748B" Margin="0,0,10,0" />
                <Button Content="Créer le projet" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Créer un projet" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="Le projet est rattaché à une fiche client et reçoit le statut initial DEVIS." Margin="0,7,0,18" TextWrapping="Wrap" />
                <TextBlock Text="Client" FontWeight="SemiBold" />
                <ComboBox x:Name="ClientBox" Margin="0,6,0,6" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="NoClientText" Text="Créez d’abord un client avec sa fiche complète pour pouvoir créer un projet suivi." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed" />
                <TextBlock Text="Code client" FontWeight="SemiBold" />
                <TextBox x:Name="ClientCodeBox" IsReadOnly="True" Background="{DynamicResource ReadOnlyInputBrush}" Margin="0,6,0,14" />
                <TextBlock Text="Année" FontWeight="SemiBold" />
                <TextBox x:Name="YearBox" MaxLength="4" Margin="0,6,0,14" />
                <TextBlock Text="Nom du projet" FontWeight="SemiBold" />
                <TextBox x:Name="ProjectNameBox" Margin="0,6,0,14" />
                <TextBlock Text="Échéance (facultative)" FontWeight="SemiBold" />
                <DatePicker x:Name="DueDateBox" Margin="0,6,0,14" />
                <TextBlock Text="Description (facultative)" FontWeight="SemiBold" />
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
