<Window x:Class="MS3DPRINT.Manager.App.Views.CreateTrackedProjectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nouveau projet" Width="600" Height="650" MinWidth="420" MinHeight="480" Style="{DynamicResource MaterialDesignWindow}" WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RetryButton" Content="Réessayer" Click="Retry_Click" Visibility="Collapsed" Margin="0,0,10,0" />
                <Button Content="Annuler" Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" />
                <Button x:Name="PreviousButton" Content="Précédent" Click="Previous_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" Visibility="Collapsed" />
                <Button x:Name="NextButton" Content="Suivant" Click="Next_Click" IsDefault="True" Margin="0,0,10,0" />
                <Button x:Name="CreateButton" Content="Créer le projet" IsDefault="True" Click="Create_Click" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock x:Name="Heading" Text="Créer un projet" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock x:Name="IntroText" Text="Étape 1 sur 3 — choisissez le client." Margin="0,7,0,18" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,18"><TextBlock Text="1. Client" FontWeight="SemiBold" Margin="0,0,18,0" /><TextBlock Text="2. Projet" Margin="0,0,18,0" /><TextBlock Text="3. Confirmation" /></WrapPanel>
            <StackPanel x:Name="ClientStepPanel">
                <TextBlock Text="Client" FontWeight="SemiBold" /><ComboBox x:Name="ClientBox" Margin="0,6,0,6" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="NoClientText" Text="Créez d’abord un client avec sa fiche complète pour pouvoir créer un projet suivi." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
                <Button x:Name="NewClientButton" Content="Nouveau client" Click="NewClient_Click" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel x:Name="ProjectStepPanel" Visibility="Collapsed">
                <TextBlock Text="Code client" FontWeight="SemiBold" /><TextBox x:Name="ClientCodeBox" IsReadOnly="True" Background="{DynamicResource ReadOnlyInputBrush}" Margin="0,6,0,14" />
                <TextBlock Text="Année" FontWeight="SemiBold" /><TextBox x:Name="YearBox" MaxLength="4" Margin="0,6,0,14" />
                <TextBlock Text="Nom du projet" FontWeight="SemiBold" /><TextBox x:Name="ProjectNameBox" Margin="0,6,0,14" />
                <TextBlock Text="Échéance (facultative)" FontWeight="SemiBold" /><DatePicker x:Name="DueDateBox" Margin="0,6,0,14" />
                <TextBlock Text="Description (facultative)" FontWeight="SemiBold" /><TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel x:Name="ConfirmationStepPanel" Visibility="Collapsed"><TextBlock Text="Prêt à créer le projet" FontWeight="SemiBold" FontSize="16" /><TextBlock x:Name="ConfirmationText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
