<Window x:Class="MS3DPRINT.Manager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="660" SizeToContent="Height" MinHeight="250"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Annuler" Click="Cancel_Click" Background="#64748B" Margin="0,0,10,0" />
            <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Apparence" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Choisissez le thème de l’application." Margin="0,7,0,22" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Thème" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeBox" Margin="0,7,0,24" SelectedIndex="0">
                    <ComboBoxItem Tag="Automatic">Automatique (Windows)</ComboBoxItem>
                    <ComboBoxItem Tag="Light">Clair</ComboBoxItem>
                    <ComboBoxItem Tag="Dark">Sombre</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Stockages" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Préparation des emplacements synchronisés." Margin="0,7,0,12" Foreground="{DynamicResource MutedBrush}" />
                <ItemsControl x:Name="StorageProviders" ItemsSource="{Binding StorageProviderCards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="190" MinHeight="120" Margin="0,0,12,12" Padding="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="28" Height="28" Margin="0,0,9,0">
                                            <Canvas x:Name="NextcloudLogo" Visibility="Collapsed"><Ellipse Width="24" Height="16" Canvas.Left="2" Canvas.Top="6" Stroke="#0082C9" StrokeThickness="2.5" /><Ellipse Width="6" Height="6" Canvas.Left="5" Canvas.Top="11" Fill="#0082C9" /><Ellipse Width="6" Height="6" Canvas.Left="17" Canvas.Top="11" Fill="#0082C9" /></Canvas>
                                            <Canvas x:Name="GoogleDriveLogo" Visibility="Collapsed"><Polygon Points="14,2 26,22 20,22 10,5" Fill="#4285F4" /><Polygon Points="10,5 20,22 8,22 2,12" Fill="#34A853" /><Polygon Points="2,12 8,22 20,22 17,17 7,17" Fill="#FBBC04" /></Canvas>
                                            <Canvas x:Name="DropboxLogo" Visibility="Collapsed"><Polygon Points="3,4 11,8 7,13 0,9" Fill="#0061FF" /><Polygon Points="13,8 21,4 24,9 17,13" Fill="#0061FF" /><Polygon Points="7,14 11,18 14,14 17,18 12,23" Fill="#0061FF" /></Canvas>
                                            <Canvas x:Name="LocalFolderLogo" Visibility="Collapsed"><Path Data="M2,7 L11,7 L14,10 L26,10 L24,24 L2,24 Z" Fill="#64748B" /></Canvas>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,4" />
                                    <TextBlock Grid.Row="2" Text="{Binding RootPath}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                            </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Nextcloud"><Setter TargetName="NextcloudLogo" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="GoogleDrive"><Setter TargetName="GoogleDriveLogo" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Dropbox"><Setter TargetName="DropboxLogo" Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="LocalFolder"><Setter TargetName="LocalFolderLogo" Property="Visibility" Value="Visible" /></DataTrigger>
                        </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,8,0,20" Background="{DynamicResource BorderBrush}" />
                <TextBlock Text="Performances" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="Diagnostic local lu une seule fois à l’ouverture." Margin="0,7,0,12" Foreground="{DynamicResource MutedBrush}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Processeur" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="ProcessorValue" Grid.Column="1" Text="Détection…" TextWrapping="Wrap" Margin="0,0,0,7" />
                    <TextBlock Grid.Row="1" Text="Threads disponibles" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="ThreadsValue" Grid.Row="1" Grid.Column="1" Text="Détection…" Margin="0,0,0,7" />
                    <TextBlock Grid.Row="2" Text="Mémoire" FontWeight="SemiBold" />
                    <TextBlock x:Name="MemoryValue" Grid.Row="2" Grid.Column="1" Text="Détection…" />
                </Grid>
                <TextBlock Text="Cartes graphiques" FontWeight="SemiBold" />
                <ItemsControl x:Name="GraphicsAdapters" Margin="0,6,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Accélération GPU : Automatique — préparation pour de futurs traitements 3D." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Les créations et déplacements actuels de fichiers ne sollicitent pas le GPU." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
