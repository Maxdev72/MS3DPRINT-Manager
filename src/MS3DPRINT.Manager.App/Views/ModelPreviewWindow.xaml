<Window x:Class="MS3DPRINT.Manager.App.Views.ModelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Aperçu 3D" Width="980" Height="680" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,14"><StackPanel><TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" /><TextBlock x:Name="PathText" Foreground="{DynamicResource HeaderMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="MessageText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" /><Button x:Name="ResetButton" Grid.Column="1" Content="Recentrer" Click="Reset_Click" IsEnabled="False" Margin="12,0,0,0" /><Button Grid.Column="2" Content="Fermer" Click="Close_Click" Margin="10,0,0,0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentBrush}" /></Grid></Border>
        <helix:HelixViewport3D x:Name="Viewport3D" Background="{DynamicResource SurfaceBrush}" ZoomExtentsWhenLoaded="True">
            <helix:DefaultLights />
            <ModelVisual3D x:Name="ModelVisual" />
        </helix:HelixViewport3D>
    </DockPanel>
</Window>
