<Window x:Class="MS3DPRINT.Manager.App.Views.GpuModelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        Title="Visualiseur 3D" Width="1000" Height="720" MinWidth="640" MinHeight="460"
        Style="{DynamicResource MaterialDesignWindow}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}"/>
                    <TextBlock x:Name="PathText" Foreground="{DynamicResource HeaderMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Choisir un fichier…" Click="Browse_Click" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Affichage" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="RenderModeBox" Width="110" SelectionChanged="Display_Changed">
                    <ComboBoxItem Content="Solide" IsSelected="True"/><ComboBoxItem Content="Filaire"/>
                </ComboBox>
                <TextBlock Text="Couleur" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="ColorPresetBox" Width="116" SelectionChanged="Preset_Changed">
                    <ComboBoxItem Content="Bleu" IsSelected="True"/><ComboBoxItem Content="Gris"/><ComboBoxItem Content="Vert"/>
                    <ComboBoxItem Content="Orange"/><ComboBoxItem Content="Rouge"/><ComboBoxItem Content="Blanc"/>
                </ComboBox>
                <TextBox x:Name="ColorHexBox" Width="90" Text="#58A6FF" Margin="8,0,0,0" ToolTip="Couleur hexadécimale, par exemple #58A6FF"/>
                <Border x:Name="ColorSwatch" Width="22" Height="22" Background="#58A6FF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0"/>
                <Button Content="Appliquer" Click="ApplyColor_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DimensionsText" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="ResetButton" Grid.Column="1" Content="Recentrer" Click="Reset_Click" IsEnabled="False" Margin="12,0,0,0"/>
                <Button Grid.Column="2" Content="Rendu classique" Click="Classic_Click" Margin="10,0,0,0" ToolTip="Ouvrir avec le moteur WPF si DirectX pose problème"/>
                <Button Grid.Column="3" Content="Fermer" Click="Close_Click" Margin="10,0,0,0"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="16,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Seuil paroi (mm)" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ThicknessBox" Text="1" Width="60" Margin="8,0"/>
                    <TextBlock Text="mm par unité du modèle" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="UnitScaleBox" Text="1" Width="60" Margin="8,0"/>
                    <CheckBox x:Name="ConfirmUnitsBox" Content="Je confirme cette échelle" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="AnalyzeButton" Content="Analyser les parois" Click="Analyze_Click" IsEnabled="False" Margin="8,0"/>
                    <Button x:Name="CancelAnalysisButton" Content="Annuler" Click="CancelAnalysis_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock Text="STL/OBJ : unités inconnues. Choisissez le seuil selon votre buse, matériau et réglages du trancheur." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="AnalysisText" Text="Analyse indicative sur échantillons, sans certification d’imprimabilité. Aucun fichier modifié." Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <hx:Viewport3DX x:Name="Viewport3D" BackgroundColor="#101923" MSAA="Disable">
            <hx:AmbientLight3D Color="#777777"/>
            <hx:DirectionalLight3D Direction="-1,-1,-2" Color="White"/>
            <hx:GroupModel3D x:Name="ModelsGroup"/>
            <hx:GroupModel3D x:Name="AnalysisGroup"/>
        </hx:Viewport3DX>
    </DockPanel>
</Window>
