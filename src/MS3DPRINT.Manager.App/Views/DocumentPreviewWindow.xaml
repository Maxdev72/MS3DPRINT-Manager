<Window x:Class="MS3DPRINT.Manager.App.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu du fichier" Width="940" Height="740" MinWidth="480" MinHeight="380"
        Style="{DynamicResource MaterialDesignWindow}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PathText" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,6,0,8" />
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
            <Button x:Name="PreviousButton" Content="← Précédent" Click="Previous_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,6,6" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="0,0,6,6" Visibility="Collapsed" Foreground="{DynamicResource InkBrush}" />
            <Button x:Name="NextButton" Content="Suivant →" Click="Next_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,12,6" />
            <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" ToolTip="Réduire le zoom" AutomationProperties.Name="Réduire le zoom" Margin="0,0,6,6" />
            <TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,0,6,6" />
            <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" ToolTip="Augmenter le zoom" AutomationProperties.Name="Augmenter le zoom" Margin="0,0,6,6" />
            <Button x:Name="FitWidthButton" Content="Ajuster à la largeur" Click="FitWidth_Click" Margin="0,0,6,6" />
            <Button x:Name="EnlargeButton" Content="Agrandir" Click="Enlarge_Click" Margin="0,0,0,6" />
        </WrapPanel>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" SizeChanged="PreviewScroll_SizeChanged">
                <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" SnapsToDevicePixels="True" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="MessageText" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Window>
