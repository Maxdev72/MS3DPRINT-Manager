<UserControl x:Class="MS3DPRINT.Manager.App.Views.TrashView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="28,23">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="Corbeille" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Les éléments supprimés conservent leurs fichiers et leurs fiches. Sélectionnez un élément pour le restaurer." TextWrapping="Wrap" Margin="0,8,0,18" Foreground="{DynamicResource MutedBrush}" /><WrapPanel><Button Content="Restaurer la sélection" Click="Restore_Click" Margin="0,0,10,10" /><Button Content="Actualiser" Click="Refresh_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,10" /></WrapPanel><TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" /></StackPanel>
        <ListView x:Name="TrashList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" SelectionMode="Single">
            <ListView.ItemTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding LocalDeletedAt, StringFormat=Supprimé le {0:dd/MM/yyyy HH:mm}}" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</UserControl>
