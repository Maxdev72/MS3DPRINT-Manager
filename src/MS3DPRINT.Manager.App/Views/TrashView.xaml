<UserControl x:Class="MS3DPRINT.Manager.App.Views.TrashView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="28,23">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="Corbeille" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Les éléments supprimés conservent leurs fichiers et leurs fiches. Sélectionnez un élément pour le restaurer." TextWrapping="Wrap" Margin="0,8,0,18" Foreground="{DynamicResource MutedBrush}" /><WrapPanel><Button x:Name="RestoreButton" IsEnabled="False" Content="Restaurer la sélection" Click="Restore_Click" Margin="0,0,10,10" /><Button Content="Actualiser" Click="Refresh_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,10" /></WrapPanel><TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" /></StackPanel>
        <ListView x:Name="TrashList" SelectionMode="Single" SelectionChanged="Trash_SelectionChanged"><ListView.View><GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Nom" Width="500" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Header="Supprimé le" Width="190" DisplayMemberBinding="{Binding LocalDeletedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
            </GridView></ListView.View></ListView>
    </DockPanel>
</UserControl>
