<UserControl x:Class="MS3DPRINT.Manager.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Clients" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="Retrouver et gérer vos fiches clients." Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Nouveau client" Click="Create_Click" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="LoadErrorText" Grid.Row="1" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Chargement…" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" Visibility="Collapsed" />
        <Grid Grid.Row="2" Margin="0,22,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <ComboBox x:Name="KindFilterBox" Grid.Column="1" SelectionChanged="KindFilter_SelectionChanged">
                <ComboBoxItem Content="Tous les types" IsSelected="True" />
                <ComboBoxItem Content="Professionnels" />
                <ComboBoxItem Content="Particuliers" />
            </ComboBox>
            <Button Grid.Column="2" Content="Actualiser" Click="Refresh_Click" Margin="12,0,0,0" />
        </Grid>
        <DockPanel Grid.Row="3">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4"><Button x:Name="OpenButton" Content="Ouvrir" Click="Open_Click" IsEnabled="False" Margin="0,0,8,8" />
                <Button x:Name="EditButton" Content="Modifier / Compléter" Click="Edit_Click" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="RenameButton" Content="Renommer" Click="Rename_Click" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="MoveButton" Content="Déplacer" Click="Move_Click" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
                <Button x:Name="TrashButton" Content="Supprimer" Click="Trash_Click" IsEnabled="False" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
            </WrapPanel>
            <ListView x:Name="ClientsList" SelectionMode="Single" ItemsSource="{Binding VisibleClients}" SelectionChanged="ClientsList_SelectionChanged"><ListView.View><GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Nom" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Code" Width="100" DisplayMemberBinding="{Binding ClientCode}" />
                    <GridViewColumn Header="Type" Width="135" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="Projets" Width="85" DisplayMemberBinding="{Binding ProjectCount}" />
                    <GridViewColumn Header="Fiche" Width="150" DisplayMemberBinding="{Binding ProfileLabel}" />
                    <GridViewColumn Header="Emplacement" Width="350" DisplayMemberBinding="{Binding ClientPath}" />
            </GridView></ListView.View></ListView>
        </DockPanel>
    </Grid>
</UserControl>
