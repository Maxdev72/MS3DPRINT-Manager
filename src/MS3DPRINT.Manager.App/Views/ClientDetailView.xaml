<UserControl Foreground="{DynamicResource TextBrush}" x:Class="MS3DPRINT.Manager.App.Views.ClientDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MS3DPRINT.Manager.App.Controls">
    <Grid Margin="24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><Button Content="← Clients" Click="Back_Click" HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}" /><TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4" /><TextBlock Text="{Binding ClientCode, StringFormat=Code client : {0}}" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
        <controls:EntityActions x:Name="ManagementActions" Grid.Row="1" />
        <TabControl x:Name="DetailTabs" Grid.Row="2" SelectedIndex="0" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Fichiers"><ContentControl x:Name="ClientFilesHost" Margin="12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></TabItem>
            <TabItem Header="Informations"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Stretch">
<TextBlock Text="Identité" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8" />
        <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsProfessional}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Raison sociale" Margin="0,0,0,4" /><TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="SIRET (facultatif)" Margin="0,12,0,4" /><TextBox Text="{Binding Siret, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsIndividual}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Prénom" Margin="0,0,0,4" /><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Nom" Margin="0,12,0,4" /><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Text="Adresse" Margin="0,16,0,4" /><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" />
        <TextBlock Text="Contact principal" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8" />
        <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsProfessional}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="Prénom" Margin="0,0,0,4" /><TextBox Text="{Binding ContactFirstName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Nom" Margin="0,12,0,4" /><TextBox Text="{Binding ContactLastName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Fonction" Margin="0,12,0,4" /><TextBox Text="{Binding ContactRole, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Text="Téléphone" Margin="0,12,0,4" /><TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="E-mail" Margin="0,12,0,4" /><TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />

                <Button Content="Enregistrer" Click="Save_Click" HorizontalAlignment="Right" Margin="0,16,0,8" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Projets"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <WrapPanel><Button Content="Ouvrir le projet" Click="OpenProject_Click" Margin="0,0,8,8" Style="{DynamicResource SecondaryButton}" /><Button Content="Nouveau projet" Click="CreateProject_Click" Margin="0,0,8,8" /><TextBlock x:Name="ProjectsLoadingText" Text="Chargement…" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></WrapPanel>
                <TextBlock x:Name="ProjectsErrorText" Grid.Row="1" Visibility="Collapsed" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListView x:Name="ProjectsList" Grid.Row="2" ItemsSource="{Binding Projects}" MinHeight="100" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"><ListView.View><GridView><GridViewColumn Header="Référence" Width="170" DisplayMemberBinding="{Binding Reference}" /><GridViewColumn Header="Projet" Width="260" DisplayMemberBinding="{Binding ProjectName}" /><GridViewColumn Header="Statut" Width="150" DisplayMemberBinding="{Binding StatusLabel}" /></GridView></ListView.View></ListView>
            </Grid></TabItem>
        </TabControl>
        <TextBlock x:Name="MessageText" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
