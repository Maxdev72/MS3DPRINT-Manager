<Window x:Class="MS3DPRINT.Manager.App.Views.ClientPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Déplacer vers un client" Width="580" SizeToContent="Height" WindowStartupLocation="CenterOwner" Style="{DynamicResource MaterialDesignWindow}" Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Choisissez le client destinataire. La référence du projet sera conservée." TextWrapping="Wrap" Margin="0,0,0,16" />
        <ComboBox x:Name="ClientsBox" DisplayMemberPath="DisplayName" AutomationProperties.Name="Client destinataire" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Annuler" IsCancel="True" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" /><Button Content="Déplacer" IsDefault="True" Click="Accept_Click" /></StackPanel>
    </StackPanel>
</Window>
