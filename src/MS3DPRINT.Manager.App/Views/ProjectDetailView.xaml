<UserControl Foreground="{DynamicResource TextBrush}" x:Class="MS3DPRINT.Manager.App.Views.ProjectDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MS3DPRINT.Manager.App.Controls">
    <Grid Margin="24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><Button Content="← Projets" Click="Back_Click" HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}" /><TextBlock Text="{Binding Reference}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4" /><TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
        <controls:EntityActions x:Name="ManagementActions" Grid.Row="1" />
        <TabControl x:Name="DetailTabs" Grid.Row="2" SelectedIndex="0" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Fichiers"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding CurrentDirectory}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip="{Binding CurrentDirectory}" />
                <WrapPanel Grid.Row="1" Margin="0,8,0,0"><Button Content="Remonter" Click="Up_Click" IsEnabled="{Binding CanGoUp}" Margin="0,0,8,8" Style="{DynamicResource SecondaryButton}" /><Button Content="Classer un fichier…" Click="Classify_Click" Margin="0,0,8,8" Style="{DynamicResource SecondaryButton}" /><Button x:Name="Preview3DButton" Content="Visualiser en 3D" Click="Preview3D_Click" IsEnabled="False" Margin="0,0,8,8" Style="{DynamicResource SecondaryButton}" /></WrapPanel>
                <WrapPanel x:Name="FileActionsHost" Grid.Row="2" Margin="0,0,0,4" />
                <ListView x:Name="FilesList" Grid.Row="3" ItemsSource="{Binding FileEntries}" SelectionChanged="File_SelectionChanged" MinHeight="140" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" />
            </Grid></TabItem>
            <TabItem Header="Informations"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Stretch">
<TextBlock Text="Client" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" /><TextBlock Text="{Binding ClientCode}" />
        <TextBlock Text="Statut" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
        <ComboBox x:Name="StatusBox" SelectionChanged="Status_SelectionChanged"><ComboBoxItem Content="DEVIS" /><ComboBoxItem Content="EN_COURS" /><ComboBoxItem Content="TERMINE" /></ComboBox>
        <TextBlock Text="Échéance" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><DatePicker SelectedDate="{Binding DueDate}" />
        <TextBlock Text="Description" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
        <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />

                <Button Content="Enregistrer" Click="Save_Click" HorizontalAlignment="Right" Margin="0,16,0,8" />
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <TextBlock x:Name="MessageText" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
