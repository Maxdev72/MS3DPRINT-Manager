<UserControl x:Class="MS3DPRINT.Manager.App.Views.ProjectDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,23">
        <Button Content="← Projets" Click="Back_Click" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Reference}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,4" />
        <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Text="Client" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,6" /><TextBlock Text="{Binding ClientCode}" />
        <TextBlock Text="Statut" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" />
        <ComboBox x:Name="StatusBox" SelectionChanged="Status_SelectionChanged"><ComboBoxItem Content="DEVIS" /><ComboBoxItem Content="EN_COURS" /><ComboBoxItem Content="TERMINE" /></ComboBox>
        <TextBlock Text="Échéance" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><DatePicker SelectedDate="{Binding DueDate}" />
        <TextBlock Text="Description" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
        <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
        <TextBlock Text="Fichiers du projet" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,6" />
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding CurrentDirectory}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip="{Binding CurrentDirectory}" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Remonter" Click="Up_Click" Margin="0,0,10,8" />
                <Button Content="Classer un fichier…" Click="Classify_Click" Margin="0,0,10,8" />
                <Button x:Name="Preview3DButton" Content="Visualiser en 3D" Click="Preview3D_Click" IsEnabled="False" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
        <ListView x:Name="FilesList" ItemsSource="{Binding FileEntries}" SelectionChanged="File_SelectionChanged" MinHeight="180" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"><ListView.ItemTemplate><DataTemplate><Border Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding Name}" /><TextBlock Grid.Column="2" Text="{Binding Length}" Foreground="{DynamicResource MutedBrush}" /></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><TextBlock x:Name="MessageText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" /><Button Content="Enregistrer" Click="Save_Click" /></StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
