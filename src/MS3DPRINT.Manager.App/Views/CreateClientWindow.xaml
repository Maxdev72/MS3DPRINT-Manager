<Window x:Class="MS3DPRINT.Manager.App.Views.CreateClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau client" Width="510" Height="405" MinWidth="430" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#A92828" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" Background="#64748B" Margin="0,0,10,0" />
                <Button Content="Créer le client" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Créer un client" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="Le dossier et son code seront créés après validation." Margin="0,7,0,22" TextWrapping="Wrap" />
            <TextBlock Text="Nom du client" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" />
            <TextBlock Text="Nom du dossier" FontWeight="SemiBold" />
            <TextBox Text="{Binding NormalizedName, Mode=OneWay}" IsReadOnly="True" Background="#E9EEF3" Margin="0,6,0,16" />
            <TextBlock Text="Code client (modifiable)" FontWeight="SemiBold" />
            <TextBox Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
