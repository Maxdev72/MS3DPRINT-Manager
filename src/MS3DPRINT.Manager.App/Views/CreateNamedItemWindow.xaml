<Window x:Class="MS3DPRINT.Manager.App.Views.CreateNamedItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="510" SizeToContent="Height" MinWidth="390" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click" Background="#64748B" Margin="0,0,10,0" />
                <Button Content="Créer le dossier" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                <TextBlock Text="Un dossier sera créé avec son arborescence de travail." Margin="0,7,0,24" TextWrapping="Wrap" />
                <TextBlock Text="Nom" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" Margin="0,6,0,18" />
                <TextBlock Text="Nom du dossier" FontWeight="SemiBold" />
                <TextBox x:Name="PreviewBox" IsReadOnly="True" Background="{DynamicResource ReadOnlyInputBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
