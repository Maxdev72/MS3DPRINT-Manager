<Window x:Class="MS3DPRINT.Manager.App.Views.CollectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier la fiche" Width="620" Height="690" MinWidth="390" MinHeight="320"
        Style="{DynamicResource MaterialDesignWindow}" Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" />
                <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Modifier la fiche" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,20" />
                <TextBlock Text="Nom" FontWeight="SemiBold" /><TextBox x:Name="NameBox" Margin="0,6,0,14" />
                <TextBlock Text="Description" /><TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="68" Margin="0,6,0,14" />
                <StackPanel x:Name="SupplierPanel">
                    <TextBlock Text="Contact" /><TextBox x:Name="ContactBox" Margin="0,6,0,14" />
                    <TextBlock Text="Adresse" /><TextBox x:Name="AddressBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,6,0,14" />
                    <TextBlock Text="Téléphone" /><TextBox x:Name="PhoneBox" Margin="0,6,0,14" />
                    <TextBlock Text="E-mail" /><TextBox x:Name="EmailBox" Margin="0,6,0,14" />
                    <TextBlock Text="Site web" /><TextBox x:Name="WebsiteBox" Margin="0,6,0,14" />
                </StackPanel>
                <TextBlock Text="Notes" /><TextBox x:Name="NotesBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
