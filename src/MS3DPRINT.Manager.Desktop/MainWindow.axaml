<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MS3DPRINT.Manager.Desktop.MainWindow"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        KeyDown="Window_KeyDown"
        Opened="Window_Opened"
        SizeChanged="Window_SizeChanged"
        Title="MS3DPRINT Manager">
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" Padding="14,20,14,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,0">
          <Image Source="avares://MS3DPRINT.Manager.Desktop/Assets/app-icon.png" Width="36" Height="36" />
          <StackPanel Classes="nav-label" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="MS3DPRINT" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="MANAGER" FontSize="12" FontWeight="SemiBold" LetterSpacing="2.5" Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavigationItems" Spacing="2">
            <TextBlock Text="ESPACE DE TRAVAIL" Classes="overline nav-label" Margin="12,0,0,8" />
            <Button Classes="nav-item selected" Tag="Accueil" Click="NavigationButton_Click" AutomationProperties.Name="Accueil"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconHome}" /><TextBlock Classes="nav-label" Text="Accueil" /></StackPanel></Button>
            <Button Classes="nav-item" Tag="Projets" Click="NavigationButton_Click" AutomationProperties.Name="Projets"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Path Classes="icon" Data="{StaticResource IconProjects}" /><TextBlock Grid.Column="1" Classes="nav-label" Text="Projets" /><Border x:Name="NavProjectsBadge" Grid.Column="2" Classes="badge nav-label" IsVisible="False"><TextBlock x:Name="NavProjectsCount" Text="0" /></Border></Grid></Button>
            <Button Classes="nav-item" Tag="Clients" Click="NavigationButton_Click" AutomationProperties.Name="Clients"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Path Classes="icon" Data="{StaticResource IconClients}" /><TextBlock Grid.Column="1" Classes="nav-label" Text="Clients" /><Border x:Name="NavClientsBadge" Grid.Column="2" Classes="badge nav-label" IsVisible="False"><TextBlock x:Name="NavClientsCount" Text="0" /></Border></Grid></Button>
            <Button Classes="nav-item" Tag="Collections" Click="NavigationButton_Click" AutomationProperties.Name="Collections"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconCollections}" /><TextBlock Classes="nav-label" Text="Collections" /></StackPanel></Button>
            <Button Classes="nav-item" Tag="Filaments" Click="NavigationButton_Click" AutomationProperties.Name="Filaments"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconFilaments}" /><TextBlock Classes="nav-label" Text="Filaments" /></StackPanel></Button>
            <Button Classes="nav-item" Tag="Estimations" Click="NavigationButton_Click" AutomationProperties.Name="Estimations"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconEstimates}" /><TextBlock Classes="nav-label" Text="Estimations" /></StackPanel></Button>
            <Button Classes="nav-item" Tag="Imprimantes" Click="NavigationButton_Click" AutomationProperties.Name="Imprimantes"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconPrinters}" /><TextBlock Classes="nav-label" Text="Imprimantes" /></StackPanel></Button>
            <Button Classes="nav-item" Tag="Corbeille" Click="NavigationButton_Click" AutomationProperties.Name="Corbeille"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconTrash}" /><TextBlock Classes="nav-label" Text="Corbeille" /></StackPanel></Button>
            <TextBlock Text="OUTILS" Classes="overline nav-label" Margin="12,20,0,8" />
            <Button Classes="nav-item" Tag="Modèles 3D" Click="NavigationButton_Click" AutomationProperties.Name="Modèles 3D"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconSearch}" /><TextBlock Classes="nav-label" Text="Modèles 3D" /></StackPanel></Button>
            <Button x:Name="ViewerNavButton" Classes="nav-item" Click="OpenThreeDViewer_Click" AutomationProperties.Name="Visualiseur 3D"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconCube}" /><TextBlock Classes="nav-label" Text="Visualiseur 3D" /></StackPanel></Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
          <Border Classes="card-raised" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
              <StackPanel Classes="nav-label" Spacing="1">
                <TextBlock Text="ATELIER NORD" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Espace local connecté" Classes="caption" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="FooterNavigation">
            <Button Classes="nav-item" Tag="Paramètres" Click="NavigationButton_Click" AutomationProperties.Name="Paramètres"><StackPanel Orientation="Horizontal" Spacing="12"><Path Classes="icon" Data="{StaticResource IconSettings}" /><TextBlock Classes="nav-label" Text="Paramètres" /></StackPanel></Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="CentralWorkspace" Grid.Column="1" Margin="34,28" Width="1200" MaxWidth="1200" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,*" RowSpacing="24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" Spacing="2" IsVisible="False" />
          <TextBlock x:Name="PageTitle" Text="Vue d’ensemble" Classes="page-title" />
          <TextBlock x:Name="PageSubtitle" Text="Bienvenue dans votre atelier. Voici ce qui mérite votre attention." Classes="muted" />
        </StackPanel>
        <Border Grid.Column="1" Classes="search-box" Width="340" Height="40" VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Path Classes="icon" Data="{StaticResource IconSearch}" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search-input" PlaceholderText="Projet, client, fichier…" KeyUp="SearchBox_KeyUp" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center" AutomationProperties.Name="Recherche globale" />
            <Border Grid.Column="2" Classes="key-hint" VerticalAlignment="Center"><TextBlock Text="Ctrl+K" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" /></Border>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="DashboardStats" Grid.Row="1" Classes="card" Padding="22,18">
        <Grid ColumnDefinitions="*,Auto,*,Auto,*">
          <StackPanel Spacing="2"><TextBlock Text="Projets" Classes="caption" /><TextBlock x:Name="ProjectCountText" Text="—" Classes="metric" /><TextBlock Text="dans votre espace de travail" Classes="caption" /></StackPanel>
          <Border Grid.Column="1" Width="1" Background="{DynamicResource SubtleBorderBrush}" Margin="24,2" />
          <StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="À faire" Classes="caption" /><TextBlock x:Name="QuoteCountText" Text="—" Classes="metric" /><TextBlock Text="pas encore démarrés" Classes="caption" /></StackPanel>
          <Border Grid.Column="3" Width="1" Background="{DynamicResource SubtleBorderBrush}" Margin="24,2" />
          <StackPanel Grid.Column="4" Spacing="2"><TextBlock Text="En cours" Classes="caption" /><TextBlock x:Name="InProgressCountText" Text="—" Classes="metric" /><TextBlock Text="en fabrication" Classes="caption" /></StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="DashboardContent" Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="20" VerticalAlignment="Top">
        <Border Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3"><TextBlock Text="Projets récents" Classes="section-title" /><TextBlock Text="Reprenez votre travail là où vous l’avez laissé." Classes="caption" /></StackPanel>
              <Button Grid.Column="1" Content="Voir les projets" Click="DashboardProjects_Click" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentProjectsList" Spacing="8" /></ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="Actions rapides" Classes="section-title" />
            <Button Classes="primary-action" Click="CreateProject_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Nouveau projet" /></StackPanel></Button>
            <Button Click="DashboardCreateClient_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><Path Classes="icon icon-sm" Data="{StaticResource IconClients}" /><TextBlock Text="Nouveau client" /></StackPanel></Button>
            <Button Click="DashboardEstimate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><Path Classes="icon icon-sm" Data="{StaticResource IconEstimates}" /><TextBlock Text="Nouvelle estimation" /></StackPanel></Button>
            <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,4" />
            <TextBlock Text="À surveiller" Classes="section-title" />
            <StackPanel x:Name="AttentionList" Spacing="8" />
          </StackPanel>
        </Border>
      </Grid>
      <Border x:Name="ProjectsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid x:Name="ProjectFilterBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="search-box" Height="36" HorizontalAlignment="Left" Width="280"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Path Classes="icon" Data="{StaticResource IconSearch}" /><TextBox x:Name="ProjectFilterBox" Grid.Column="1" Classes="search-input" PlaceholderText="Filtrer les projets…" TextChanged="ProjectFilterText_Changed" AutomationProperties.Name="Filtrer les projets…" /></Grid></Border>
            <WrapPanel x:Name="ProjectStatusFilters" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Classes="filter-chip selected" Content="Tous" Tag="" Click="ProjectFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="À faire" Tag="A_FAIRE" Click="ProjectFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="En cours" Tag="EN_COURS" Click="ProjectFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="Terminés" Tag="TERMINE" Click="ProjectFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="Archivés" Tag="ARCHIVES" Click="ProjectFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="À compléter" Tag="TODO" Click="ProjectFilter_Click" Margin="0,0,6,0" /></WrapPanel>
            <StackPanel x:Name="ProjectsPanelHeader" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock x:Name="ProjectsPanelTitle" Text="Tous les projets" Classes="section-title" IsVisible="False" />
              <TextBlock x:Name="ProjectsPanelSubtitle" Text="Catalogue lu depuis votre espace de travail." Classes="caption" VerticalAlignment="Center" />
              <StackPanel x:Name="ProjectsPanelActions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Classes="tool" Click="RefreshProjects_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button><Button Classes="primary-action" Click="CreateProject_Click" AutomationProperties.Name="Créer"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Créer" /></StackPanel></Button></StackPanel>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="ProjectList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" />
          </ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="ClientsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <Grid x:Name="ClientFilterBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="search-box" Height="36" HorizontalAlignment="Left" Width="280"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Path Classes="icon" Data="{StaticResource IconSearch}" /><TextBox x:Name="ClientFilterBox" Grid.Column="1" Classes="search-input" PlaceholderText="Filtrer les clients…" TextChanged="ClientFilterText_Changed" AutomationProperties.Name="Filtrer les clients…" /></Grid></Border>
            <WrapPanel x:Name="ClientStatusFilters" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Classes="filter-chip selected" Content="Tous" Tag="" Click="ClientFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="Professionnels" Tag="Professionnel" Click="ClientFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="Particuliers" Tag="Particulier" Click="ClientFilter_Click" Margin="0,0,6,0" /><Button Classes="filter-chip" Content="À compléter" Tag="Fiche à compléter" Click="ClientFilter_Click" Margin="0,0,6,0" /></WrapPanel>
            <StackPanel x:Name="ClientsPanelHeader" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock x:Name="ClientsPanelTitle" Text="Tous les clients" Classes="section-title" IsVisible="False" />
              <TextBlock x:Name="ClientsPanelSubtitle" Text="Catalogue lu depuis votre espace de travail." Classes="caption" VerticalAlignment="Center" />
              <StackPanel x:Name="ClientsPanelActions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Classes="tool" Click="RefreshClients_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button><Button Classes="primary-action" Click="CreateClient_Click" AutomationProperties.Name="Créer"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Créer" /></StackPanel></Button></StackPanel>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="ClientList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="CollectionsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel x:Name="CollectionFilters" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="filter-chip selected" Content="Tout" Tag="" Click="CollectionFilter_Click" />
              <Button Classes="filter-chip" Content="Modèles 3D" Tag="02_MODELES_3D" Click="CollectionFilter_Click" />
              <Button Classes="filter-chip" Content="Produits" Tag="03_PRODUITS_MS3DPRINT" Click="CollectionFilter_Click" />
              <Button Classes="filter-chip" Content="Fournisseurs" Tag="06_FOURNISSEURS" Click="CollectionFilter_Click" />
            </StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="tool" Click="RefreshCollections_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button><Button Classes="primary-action" Click="CreateCollection_Click" AutomationProperties.Name="Créer"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Créer" /></StackPanel></Button></StackPanel></Grid>
          <Grid Grid.Row="1" RowDefinitions="*">
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="CollectionList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" /></ScrollViewer>
          </Grid>
        </Grid>
      </Border>
      <Border x:Name="FilamentsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="tool" Click="RefreshFilaments_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button><Button Classes="primary-action" Click="CreateFilament_Click" AutomationProperties.Name="Ajouter"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Ajouter" /></StackPanel></Button></StackPanel></Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="FilamentList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="EstimatesWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="card" Padding="24">
        <Grid ColumnDefinitions="*,320" ColumnSpacing="28">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Nouvelle estimation" Classes="section-title" /><TextBlock Text="Un calcul de prix de vente fondé sur vos coûts réels, vos aléas et votre marge." Classes="muted" TextWrapping="Wrap" /></StackPanel><Button Classes="tool" Grid.Column="1" VerticalAlignment="Top" Click="RefreshEstimates_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button></Grid>
            <Grid Grid.Row="1" x:Name="EstimateStepper" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
              <Button Grid.Column="0" Classes="ghost step-chip active" Tag="0" Click="EstimateStep_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="step-dot"><TextBlock Text="1" /></Border><TextBlock Text="Prestation" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="1" Classes="ghost step-chip" Tag="1" Click="EstimateStep_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="step-dot"><TextBlock Text="2" /></Border><TextBlock Text="Impression" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="2" Classes="ghost step-chip" Tag="2" Click="EstimateStep_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="step-dot"><TextBlock Text="3" /></Border><TextBlock Text="Coûts et marge" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="3" Classes="ghost step-chip" Tag="3" Click="EstimateStep_Click" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="step-dot"><TextBlock Text="4" /></Border><TextBlock Text="Récapitulatif" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Panel Margin="0,0,16,0">
                <StackPanel x:Name="EstimateStep0" Spacing="14">
                  <TextBlock Text="Que souhaitez-vous chiffrer ?" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Nom de l’estimation" Classes="muted" /><TextBox x:Name="EstimateName" Text="Nouvelle estimation" />
                  <TextBlock Text="Projet / client" Classes="muted" /><ComboBox x:Name="EstimateProject" PlaceholderText="Sans projet lié (optionnel)" HorizontalAlignment="Stretch" />
                  <TextBlock Text="Type de prestation" Classes="muted" Margin="0,4,0,0" /><Grid x:Name="EstimateScope" ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Grid.Column="0" Classes="scope-choice selected" Tag="0" Click="EstimateScope_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="6" HorizontalAlignment="Center"><Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Impression 3D" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button><Button Grid.Column="1" Classes="scope-choice" Tag="1" Click="EstimateScope_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="6" HorizontalAlignment="Center"><Path Data="M4,20 L8,19 L19,8 A2.1,2.1 0 0 0 16,5 L5,16 Z M14,7 L17,10" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="Modélisation seule" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button><Button Grid.Column="2" Classes="scope-choice" Tag="2" Click="EstimateScope_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="6" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"><Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Text="+" VerticalAlignment="Center" FontSize="16" /><Path Data="M4,20 L8,19 L19,8 A2.1,2.1 0 0 0 16,5 L5,16 Z M14,7 L17,10" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" /></StackPanel><TextBlock Text="Impression + modélisation" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button></Grid>
                </StackPanel>
                <StackPanel x:Name="EstimateStep1" Spacing="14" IsVisible="False">
                  <TextBlock Text="Matière et machine" FontSize="16" FontWeight="SemiBold" />
                  <StackPanel x:Name="EstimatePrintInputs" Spacing="14">
                    <TextBlock Text="Filament" Classes="muted" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox x:Name="EstimateFilament" PlaceholderText="Aucun filament : ajoutez-en un" HorizontalAlignment="Stretch" /><Button Grid.Column="1" x:Name="EstimateAddFilamentButton" Content="Nouveau filament" Click="EstimateAddFilament_Click" /></Grid>
                    <TextBlock Text="Imprimante" Classes="muted" /><ComboBox x:Name="EstimatePrinter" SelectionChanged="EstimatePrinter_SelectionChanged" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Poids" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateWeight" Text="100" /><TextBlock Grid.Column="1" Text="g" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Durée machine" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateHours" Text="2" TextChanged="EstimateElectricityInputs_Changed" /><TextBlock Grid.Column="1" Text="h" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Taux horaire machine" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateMachineRate" Text="2" /><TextBlock Grid.Column="1" Text="€/h" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Prix électricité" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateKwhPrice" Text="0,25" TextChanged="EstimateElectricityInputs_Changed" /><TextBlock Grid.Column="1" Text="€/kWh" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                    <StackPanel><TextBlock x:Name="EstimateElectricityLabel" Text="Électricité estimée" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateElectricity" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="EstimateStep2" Spacing="14" IsVisible="False">
                  <TextBlock Text="Coûts complémentaires" FontSize="16" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Modélisation / conception" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateDesign" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Main-d’œuvre" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateLabor" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Post-traitement" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimatePostProcessing" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Consommables" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateConsumables" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Emballage / expédition" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimatePackaging" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Autres coûts" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateMisc" Text="0" /><TextBlock Grid.Column="1" Text="€" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                  <TextBlock Text="MARGE ET ALÉAS" Classes="overline" Margin="0,10,0,0" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Marge sur coût" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateMargin" Text="30" /><TextBlock Grid.Column="1" Text="%" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Échec" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateFailure" Text="5" /><TextBlock Grid.Column="1" Text="%" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Remise" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="EstimateDiscount" Text="0" /><TextBlock Grid.Column="1" Text="%" Classes="muted" VerticalAlignment="Center" /></Grid></StackPanel></Grid>
                </StackPanel>
                <StackPanel x:Name="EstimateStep3" Spacing="14" IsVisible="False">
                  <TextBlock Text="Récapitulatif du prix" FontSize="16" FontWeight="SemiBold" />
                  <StackPanel x:Name="EstimateRecap" Spacing="8" />
                </StackPanel>
              </Panel>
            </ScrollViewer>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <Button Classes="ghost" Content="Réinitialiser" Click="ResetEstimate_Click" />
              <Button x:Name="EstimateBackButton" Grid.Column="2" Content="Précédent" Click="EstimateBack_Click" IsVisible="False" />
              <Button x:Name="EstimateNextButton" Grid.Column="3" Classes="primary-action" Content="Suivant" Click="EstimateNext_Click" />
              <Button x:Name="EstimateSaveButton" Grid.Column="3" Classes="primary-action" Content="Enregistrer l’estimation" Click="SaveEstimate_Click" IsVisible="False" />
            </Grid>
          </Grid>
          <Border Grid.Column="1" Classes="card-raised" Padding="22"><StackPanel Spacing="12"><TextBlock Text="RÉSULTAT" Classes="overline"/><TextBlock x:Name="EstimateFinal" Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="EstimateDetail" Text="Sélectionnez un filament et calculez." Classes="muted" TextWrapping="Wrap"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/><TextBlock Text="DERNIÈRES ESTIMATIONS" Classes="overline"/><StackPanel x:Name="SavedEstimateList" Spacing="6"/></StackPanel></Border>
        </Grid>
      </Border>
      <Border x:Name="PrintersWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="tool" Click="RefreshPrinters_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button><Button Classes="primary-action" Click="CreatePrinter_Click" AutomationProperties.Name="Ajouter"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon icon-sm" Data="{StaticResource IconPlus}" /><TextBlock Text="Ajouter" /></StackPanel></Button></StackPanel></Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="PrinterList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="ModelSearchWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel" />
      <Border x:Name="TrashWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel /><Button Classes="tool" Grid.Column="1" Click="RefreshTrash_Click" AutomationProperties.Name="Actualiser" ToolTip.Tip="Actualiser la liste"><Path Classes="icon" Data="{StaticResource IconRefresh}" /></Button></Grid><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><StackPanel x:Name="TrashList" HorizontalAlignment="Stretch" Spacing="0" Margin="0,0,10,0" /></ScrollViewer></Grid>
      </Border>
      <Border x:Name="SettingsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StorageList" Spacing="16" /></ScrollViewer></Border>
      <Border x:Name="FolderWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <StackPanel Spacing="4"><TextBlock x:Name="FolderWorkspaceTitle" Text="Dossiers" Classes="section-title" /><TextBlock x:Name="FolderWorkspaceLocation" Classes="muted" TextWrapping="Wrap" /></StackPanel>
          <ScrollViewer Grid.Row="1"><StackPanel x:Name="FolderWorkspaceList" Spacing="0" Margin="0,0,10,0" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="ViewerWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Classes="panel" />
      <Border x:Name="SearchResultsPanel" Grid.RowSpan="3" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="440" MaxHeight="460" Margin="0,46,0,0" ZIndex="10" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
      <ScrollViewer MaxHeight="440">
        <StackPanel x:Name="SearchResults" Spacing="4" />
      </ScrollViewer>
    </Border>
    </Grid>
      <ProgressBar x:Name="BusyBar" Grid.Column="1" Classes="busy" IsIndeterminate="True" IsVisible="False" VerticalAlignment="Top" />
    <Grid x:Name="SidePanelOverlay" Grid.ColumnSpan="2" IsVisible="False" ZIndex="100" KeyDown="SidePanel_KeyDown">
      <Border Background="#99060A12" />
      <Border x:Name="SidePanel" HorizontalAlignment="Right" Width="460" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" BoxShadow="-12 0 36 0 #66000000">
        <Border.Styles>
          <Style Selector="Border#SidePanel"><Setter Property="RenderTransform" Value="translateX(520px)" /><Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions></Setter></Style>
          <Style Selector="Border#SidePanel.open"><Setter Property="RenderTransform" Value="translateX(0px)" /></Style>
        </Border.Styles>
        <Border x:Name="SidePanelBody" />
      </Border>
    </Grid>
    <StackPanel x:Name="ToastHost" Grid.Column="1" ZIndex="200" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,24" Spacing="8" />
  </Grid>
</Window>
