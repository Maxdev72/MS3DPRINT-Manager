<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MS3DPRINT.Manager.Desktop.MainWindow"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="{DynamicResource CanvasBrush}"
        KeyDown="Window_KeyDown"
        Opened="Window_Opened"
        Title="MS3DPRINT Manager">
  <Grid ColumnDefinitions="232,*">
    <Border Background="#0B111B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,22">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="MS3DPRINT" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="MANAGER" FontSize="11" LetterSpacing="2" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <StackPanel x:Name="NavigationItems" Grid.Row="1" Margin="0,38,0,0" Spacing="6">
          <TextBlock Text="ESPACE DE TRAVAIL" Classes="muted" Margin="10,0,0,8" />
          <Button Classes="nav-item selected" Content="Accueil" Tag="Accueil" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Projets" Tag="Projets" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Clients" Tag="Clients" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Collections" Tag="Collections" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Filaments" Tag="Filaments" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Estimations" Tag="Estimations" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          <Button Classes="nav-item" Content="Corbeille" Tag="Corbeille" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10">
          <Border Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="ATELIER NORD" FontWeight="SemiBold" />
              <TextBlock Text="Espace local connecté" Classes="muted" />
            </StackPanel>
          </Border>
          <Button Classes="nav-item" Content="Paramètres" Tag="Paramètres" Click="NavigationButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,28" RowDefinitions="Auto,Auto,*" RowSpacing="28">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="6">
          <TextBlock x:Name="PageTitle" Text="Vue d’ensemble" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock x:Name="PageSubtitle" Text="Bienvenue dans votre atelier. Voici ce qui mérite votre attention." Classes="muted" />
        </StackPanel>
        <Grid Grid.Column="1" Width="286" Height="42">
          <TextBox x:Name="SearchBox" PlaceholderText="Rechercher partout" KeyUp="SearchBox_KeyUp" Padding="13,0" />
          <TextBlock Text="Ctrl+K" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
        </Grid>
      </Grid>
      <Grid x:Name="DashboardStats" Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="10"><TextBlock Text="PROJETS" Classes="muted" /><TextBlock x:Name="ProjectCountText" Text="—" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Dans votre espace de travail" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="10"><TextBlock Text="DEVIS" Classes="muted" /><TextBlock x:Name="QuoteCountText" Text="—" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Projets à chiffrer" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="10"><TextBlock Text="EN COURS" Classes="muted" /><TextBlock x:Name="InProgressCountText" Text="—" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Projets en fabrication" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="DashboardContent" Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="20">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4"><TextBlock Text="Projets récents" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Reprenez votre travail là où vous l’avez laissé." Classes="muted" /></StackPanel>
              <Button Grid.Column="1" Content="Voir les projets" Click="DashboardProjects_Click" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="10">
              <Border Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="9" Padding="15"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock x:Name="RecentProjectOneTitle" Text="Chargement des projets…" FontWeight="SemiBold" /><TextBlock x:Name="RecentProjectOneDetail" Text="" Classes="muted" /></StackPanel><TextBlock x:Name="RecentProjectOneStatus" Grid.Column="1" Text="" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" /></Grid></Border>
              <Border Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="9" Padding="15"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock x:Name="RecentProjectTwoTitle" Text="" FontWeight="SemiBold" /><TextBlock x:Name="RecentProjectTwoDetail" Text="" Classes="muted" /></StackPanel><TextBlock x:Name="RecentProjectTwoStatus" Grid.Column="1" Text="" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" /></Grid></Border>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel Spacing="16"><TextBlock Text="Activité" FontSize="18" FontWeight="SemiBold" /><StackPanel Spacing="6"><TextBlock Text="Espace de travail" Classes="muted" /><TextBlock x:Name="WorkspaceStatusText" Text="Lecture des données…" TextWrapping="Wrap" /></StackPanel><StackPanel Spacing="6"><TextBlock Text="Clients" Classes="muted" /><TextBlock x:Name="ClientCountText" Text="—" TextWrapping="Wrap" /></StackPanel><Border Height="1" Background="{DynamicResource BorderBrush}" /><Button Content="Créer un projet" Click="CreateProject_Click" HorizontalAlignment="Left" /></StackPanel>
        </Border>
      </Grid>
      <Border x:Name="ProjectsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4"><TextBlock Text="Tous les projets" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Catalogue lu depuis votre espace de travail." Classes="muted" /></StackPanel>
            <Button Grid.Column="1" Content="Actualiser" Click="RefreshProjects_Click" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ProjectList" Spacing="8" />
          </ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="ClientsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4"><TextBlock Text="Tous les clients" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Catalogue lu depuis votre espace de travail." Classes="muted" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Créer" Click="CreateClient_Click" /><Button Content="Actualiser" Click="RefreshClients_Click" VerticalAlignment="Center" /></StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1"><StackPanel x:Name="ClientList" Spacing="8" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="CollectionsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Collections" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Modèles 3D, produits et fournisseurs." Classes="muted" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Créer" Click="CreateCollection_Click" /><Button Content="Actualiser" Click="RefreshCollections_Click" VerticalAlignment="Center" /></StackPanel></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel x:Name="CollectionList" Spacing="8" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="FilamentsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Filaments" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Stock de matières et caractéristiques." Classes="muted" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Ajouter" Click="CreateFilament_Click" /><Button Content="Actualiser" Click="RefreshFilaments_Click" VerticalAlignment="Center" /></StackPanel></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel x:Name="FilamentList" Spacing="8" /></ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="EstimatesWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid ColumnDefinitions="*,300" ColumnSpacing="28">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="14">
            <TextBlock Text="Nouvelle estimation" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Un calcul de prix de vente fondé sur vos coûts réels, vos aléas et votre marge." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Filament" /><ComboBox x:Name="EstimateFilament" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Poids (g)" Classes="muted"/><TextBox x:Name="EstimateWeight" Text="100" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Durée machine (h)" Classes="muted"/><TextBox x:Name="EstimateHours" Text="2" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Coût machine €/h" Classes="muted"/><TextBox x:Name="EstimateMachineRate" Text="2" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Électricité (€)" Classes="muted"/><TextBox x:Name="EstimateElectricity" Text="0" /></StackPanel></Grid>
            <TextBlock Text="COÛTS COMPLÉMENTAIRES" Classes="muted" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Conception (€)" Classes="muted"/><TextBox x:Name="EstimateDesign" Text="0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Main-d’œuvre (€)" Classes="muted"/><TextBox x:Name="EstimateLabor" Text="0" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Post-traitement (€)" Classes="muted"/><TextBox x:Name="EstimatePostProcessing" Text="0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Consommables (€)" Classes="muted"/><TextBox x:Name="EstimateConsumables" Text="0" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Emballage / expédition (€)" Classes="muted"/><TextBox x:Name="EstimatePackaging" Text="0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Autres coûts (€)" Classes="muted"/><TextBox x:Name="EstimateMisc" Text="0" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="Marge %" Classes="muted"/><TextBox x:Name="EstimateMargin" Text="30" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Échec %" Classes="muted"/><TextBox x:Name="EstimateFailure" Text="5" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Remise %" Classes="muted"/><TextBox x:Name="EstimateDiscount" Text="0" /></StackPanel></Grid>
            <Button Content="Calculer l’estimation" Click="CalculateEstimate_Click" HorizontalAlignment="Left" />
          </StackPanel></ScrollViewer>
          <Border Grid.Column="1" Background="{DynamicResource RaisedSurfaceBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="12"><TextBlock Text="RÉSULTAT" Classes="muted"/><TextBlock x:Name="EstimateFinal" Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="EstimateDetail" Text="Sélectionnez un filament et calculez." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
      </Border>
      <Border x:Name="TrashWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid RowDefinitions="Auto,*" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Corbeille" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Éléments supprimés de façon réversible." Classes="muted" /></StackPanel><Button Grid.Column="1" Content="Actualiser" Click="RefreshTrash_Click" VerticalAlignment="Center" /></Grid><ScrollViewer Grid.Row="1"><StackPanel x:Name="TrashList" Spacing="8" /></ScrollViewer></Grid>
      </Border>
      <Border x:Name="SettingsWorkspacePanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20"><Grid RowDefinitions="Auto,*" RowSpacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Paramètres" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Emplacements de stockage disponibles." Classes="muted" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Classer un fichier" Click="ClassifyFile_Click" /><Button Content="Visualiseur 3D" Click="OpenThreeDViewer_Click" /><Button Content="Vérifier l’arborescence" Click="VerifyWorkspace_Click" /><Button Content="Actualiser" Click="RefreshSettings_Click" VerticalAlignment="Center" /></StackPanel></Grid><StackPanel x:Name="StorageList" Grid.Row="1" Spacing="8" /></Grid></Border>
    </Grid>
    <Border x:Name="SearchResultsPanel" Grid.Column="1" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="390" MaxHeight="420" Margin="0,82,34,0" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
      <ScrollViewer MaxHeight="400">
        <StackPanel x:Name="SearchResults" Spacing="4" />
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
