<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MS3DPRINT.Manager.Desktop.Controls"
             x:Class="MS3DPRINT.Manager.Desktop.Controls.SectionPanel"
             x:Name="Root">
  <Border Background="{DynamicResource RaisedSurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource PanelCornerRadius}"
          Padding="18">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <ContentPresenter Content="{Binding Header, ElementName=Root}" />
      <ContentPresenter Grid.Row="1" Content="{Binding Body, ElementName=Root}" />
      <ContentPresenter Grid.Row="2" Content="{Binding Footer, ElementName=Root}" />
    </Grid>
  </Border>
</UserControl>
