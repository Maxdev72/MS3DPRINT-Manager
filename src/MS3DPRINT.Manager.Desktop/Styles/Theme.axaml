<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Surfaces -->
      <SolidColorBrush x:Key="CanvasBrush" Color="#080C14" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#0A101B" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0E1522" />
      <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#141D2D" />
      <SolidColorBrush x:Key="HoverBrush" Color="#1B2740" />
      <SolidColorBrush x:Key="PressedBrush" Color="#25375A" />
      <!-- Lines -->
      <SolidColorBrush x:Key="BorderBrush" Color="#243247" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1A2538" />
      <!-- Text (contrast on SurfaceBrush: text 15:1, muted 7:1, faint 4.6:1) -->
      <SolidColorBrush x:Key="TextBrush" Color="#EAF0FC" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#93A5C2" />
      <SolidColorBrush x:Key="FaintTextBrush" Color="#7385A3" />
      <!-- Accent and states -->
      <SolidColorBrush x:Key="AccentBrush" Color="#6B9BFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2C4D" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08101F" />
      <SolidColorBrush x:Key="FocusBorderBrush" Color="#9BC0FF" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#46D6A4" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#10322A" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F4BC52" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#392D12" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F57F7F" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1F" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1D283B" />

      <!-- Spacing, radius and type scale -->
      <x:Double x:Key="PagePadding">30</x:Double>
      <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <x:Double x:Key="FontSizeCaption">12</x:Double>
      <x:Double x:Key="FontSizeBody">14</x:Double>
      <x:Double x:Key="FontSizeSubtitle">16</x:Double>
      <x:Double x:Key="FontSizeTitle">26</x:Double>
      <x:Double x:Key="ControlHeight">38</x:Double>

      <!-- Icons: 24x24 grid, drawn with a 1.8 px round stroke -->
      <StreamGeometry x:Key="IconHome">M3 11.5 12 4l9 7.5 M5.5 10v9.5h13V10 M10 19.5v-5h4v5</StreamGeometry>
      <StreamGeometry x:Key="IconProjects">M3 7.5A1.5 1.5 0 0 1 4.5 6h4.2l2 2.2h8.8A1.5 1.5 0 0 1 21 9.7v7.8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z</StreamGeometry>
      <StreamGeometry x:Key="IconClients">M9 11a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z M3 19.5c.4-3 3-4.8 6-4.8s5.6 1.8 6 4.8 M16.5 5.2a3 3 0 0 1 0 5.6 M17.5 14.9c2 .5 3.2 2 3.5 4.3</StreamGeometry>
      <StreamGeometry x:Key="IconCollections">M12 3.5 21 8l-9 4.5L3 8Z M3 12.2l9 4.5 9-4.5 M3 16.2l9 4.5 9-4.5</StreamGeometry>
      <StreamGeometry x:Key="IconFilaments">M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M12 3.5v6 M12 14.5v6</StreamGeometry>
      <StreamGeometry x:Key="IconEstimates">M6 3.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z M8 7.5h8 M8.5 12h.01 M12 12h.01 M15.5 12h.01 M8.5 15.8h.01 M12 15.8h.01 M15.5 15.8h.01</StreamGeometry>
      <StreamGeometry x:Key="IconPrinters">M7 9V4h10v5 M6 17H4.5A1.5 1.5 0 0 1 3 15.5v-5A1.5 1.5 0 0 1 4.5 9h15a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5H18 M7 14h10v6.5H7Z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M4 7h16 M9.5 7V4.5h5V7 M6 7l1 13h10l1-13 M10 11v6 M14 11v6</StreamGeometry>
      <StreamGeometry x:Key="IconCube">M12 2.8 20.5 7.5v9L12 21.2 3.5 16.5v-9Z M3.8 7.7 12 12.3l8.2-4.6 M12 12.3v8.6</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M4 7h9 M17 7h3 M15 5v4 M4 17h3 M11 17h9 M9 15v4 M4 12h16</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M20 12a8 8 0 1 1-2.3-5.7 M20 4v4.5h-4.5</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Z M16 16l5 5</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M5 12.5l4.5 4.5L19 7.5</StreamGeometry>
      <StreamGeometry x:Key="IconAlert">M12 4 21.5 20h-19Z M12 10v4.5 M12 17.4h.01</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M12 11v5.5 M12 7.6h.01</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6 6l12 12 M18 6 6 18</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10.5a.5.5 0 0 1-.5-.5v-16a.5.5 0 0 1 .5-.5Z M14 3.5v4h4 M9 12.5h6 M9 16h6</StreamGeometry>
      <StreamGeometry x:Key="IconActivity">M3 12h4l3-7 4 14 3-7h4</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, Arial" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Buttons: secondary by default; .primary-action, .ghost and .danger are the other variants -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /></Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45" /></Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="SelectionBrush" Value="#3A5FA8" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBox:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
  </Style>
  <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="True" /></Style>
</Styles>
