<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="IconFlag">M5 3v18 M5 4H19L16 9L19 14H5Z</StreamGeometry>
      <!-- Surfaces -->
      <SolidColorBrush x:Key="CanvasBrush" Color="#071225" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#060E1C" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0C1A2D" />
      <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#11243B" />
      <SolidColorBrush x:Key="HoverBrush" Color="#183650" />
      <SolidColorBrush x:Key="PressedBrush" Color="#234967" />
      <!-- Lines -->
      <SolidColorBrush x:Key="BorderBrush" Color="#2A4664" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1C334E" />
      <SolidColorBrush x:Key="OverlayScrimBrush" Color="#99060A12" />
      <StreamGeometry x:Key="IconCopy">M8 8H20V20H8Z M16 8V4H4V16H8</StreamGeometry>
      <!-- Text roles retain strong contrast on the navy surfaces. -->
      <SolidColorBrush x:Key="TextBrush" Color="#F5F9FF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#B1C2D9" />
      <SolidColorBrush x:Key="FaintTextBrush" Color="#91AAC8" />
      <!-- Accent and states -->
      <SolidColorBrush x:Key="AccentBrush" Color="#76B8FF" />
      <SolidColorBrush x:Key="BrandBlueBrush" Color="#245CFF" />
      <SolidColorBrush x:Key="BrandBlueHoverBrush" Color="#386DFF" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B3EDC" />
      <SolidColorBrush x:Key="SelectionTextBrush" Color="#3A5FA8" />
      <SolidColorBrush x:Key="DangerBorderBrush" Color="#5A2A30" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#142C59" />
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#071225" />
      <SolidColorBrush x:Key="FocusBorderBrush" Color="#66C7FF" />
      <SolidColorBrush x:Key="CyanBrush" Color="#38BDF8" />
      <SolidColorBrush x:Key="CyanSoftBrush" Color="#0C3048" />
      <LinearGradientBrush x:Key="WorkbenchBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#102A52" /><GradientStop Offset="1" Color="#0B1B31" />
      </LinearGradientBrush>
      <FontFamily x:Key="BrandFont">avares://MS3DPRINT.Manager.Desktop/Assets/Fonts#Bricolage Grotesque</FontFamily>
      <SolidColorBrush x:Key="SuccessBrush" Color="#46D6A4" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#10322A" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F4BC52" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#392D12" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F57F7F" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1F" />
      <!-- Native dropdowns, including their separate popup host, share the app palette. -->
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceBrush" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="BorderBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="PressedBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="AccentBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="FocusBorderBrush" />
      <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="SurfaceBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="PressedBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="CyanSoftBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="HoverBrush" />
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="PressedBrush" />
      <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextBrush" />
      <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextBrush" />
      <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="TextBrush" />
      <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextBrush" />
      <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="TextBrush" />
      <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="TextBrush" />
      <!-- Fluent's own accent-coloured parts (slider, check box) follow the app accent -->
      <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
      <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="FocusBorderBrush" />
      <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="FocusBorderBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="FocusBorderBrush" />
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentBrush" />
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnAccentBrush" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1D283B" />

      <!-- Spacing, radius and type scale -->
      <x:Double x:Key="PagePadding">30</x:Double>
      <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <x:Double x:Key="FontSizeCaption">13</x:Double>
      <x:Double x:Key="FontSizeBody">14</x:Double>
      <x:Double x:Key="FontSizeSubtitle">18</x:Double>
      <x:Double x:Key="FontSizeTitle">30</x:Double>
      <x:Double x:Key="ControlHeight">42</x:Double>

      <!-- Icons: 24x24 grid, drawn with a 1.8 px round stroke -->
      <StreamGeometry x:Key="IconHome">M3 11.5 12 4l9 7.5 M5.5 10v9.5h13V10 M10 19.5v-5h4v5</StreamGeometry>
      <StreamGeometry x:Key="IconProjects">M3 7.5A1.5 1.5 0 0 1 4.5 6h4.2l2 2.2h8.8A1.5 1.5 0 0 1 21 9.7v7.8a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z</StreamGeometry>
      <StreamGeometry x:Key="IconClients">M9 11a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z M3 19.5c.4-3 3-4.8 6-4.8s5.6 1.8 6 4.8 M16.5 5.2a3 3 0 0 1 0 5.6 M17.5 14.9c2 .5 3.2 2 3.5 4.3</StreamGeometry>
      <StreamGeometry x:Key="IconCollections">M12 3.5 21 8l-9 4.5L3 8Z M3 12.2l9 4.5 9-4.5 M3 16.2l9 4.5 9-4.5</StreamGeometry>
      <StreamGeometry x:Key="IconFilaments">M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z M12 3.5v6 M12 14.5v6</StreamGeometry>
      <StreamGeometry x:Key="IconEstimates">M6 3.5h12a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z M8 7.5h8 M8.5 12h.01 M12 12h.01 M15.5 12h.01 M8.5 15.8h.01 M12 15.8h.01 M15.5 15.8h.01</StreamGeometry>
      <StreamGeometry x:Key="IconPrinters">M7 9V4h10v5 M6 17H4.5A1.5 1.5 0 0 1 3 15.5v-5A1.5 1.5 0 0 1 4.5 9h15a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5H18 M7 14h10v6.5H7Z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M4 7h16 M9.5 7V4.5h5V7 M6 7l1 13h10l1-13 M10 11v6 M14 11v6</StreamGeometry>
      <StreamGeometry x:Key="IconCamera">M3.5 8h3.2l1.6-2.2h7.4L17.3 8h3.2v11h-17Z M8.5 13.5a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0</StreamGeometry>
      <StreamGeometry x:Key="IconRecenter">M12 3v4 M12 17v4 M3 12h4 M17 12h4 M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0</StreamGeometry>
      <StreamGeometry x:Key="IconWireframe">M12 3l8 4.5v9L12 21l-8-4.5v-9Z M4.3 7.6 12 12l7.7-4.4 M12 12v8.8</StreamGeometry>
      <StreamGeometry x:Key="IconMeasure">M3.5 16.5 16.5 3.5l4 4-13 13Z M7 13l2.2 2.2 M10 10l2.2 2.2 M13 7l2.2 2.2</StreamGeometry>
      <StreamGeometry x:Key="IconCut">M12 3l8 4.5v9L12 21l-8-4.5v-9Z M2.5 12h19</StreamGeometry>
      <StreamGeometry x:Key="IconFace">M12 3l8 4.5v9L12 21l-8-4.5v-9Z M4 16.5l8 4.5 8-4.5-8-4.5Z</StreamGeometry>
      <StreamGeometry x:Key="IconCompare">M4 5h10v10H4Z M10 9h10v10H10Z</StreamGeometry>
      <StreamGeometry x:Key="IconCube">M12 2.8 20.5 7.5v9L12 21.2 3.5 16.5v-9Z M3.8 7.7 12 12.3l8.2-4.6 M12 12.3v8.6</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M4 7h9 M17 7h3 M15 5v4 M4 17h3 M11 17h9 M9 15v4 M4 12h16</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M20 12a8 8 0 1 1-2.3-5.7 M20 4v4.5h-4.5</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Z M16 16l5 5</StreamGeometry>
      <StreamGeometry x:Key="IconLock">M6 11h12v9H6Z M8.5 11V8a3.5 3.5 0 0 1 7 0v3</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M5 12.5l4.5 4.5L19 7.5</StreamGeometry>
      <StreamGeometry x:Key="IconAlert">M12 4 21.5 20h-19Z M12 10v4.5 M12 17.4h.01</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z M12 11v5.5 M12 7.6h.01</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6 6l12 12 M18 6 6 18</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10.5a.5.5 0 0 1-.5-.5v-16a.5.5 0 0 1 .5-.5Z M14 3.5v4h4 M9 12.5h6 M9 16h6</StreamGeometry>
      <StreamGeometry x:Key="IconOpen">M14 4h6v6 M20 4l-9 9 M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M4 20l4-1 11-11a2.1 2.1 0 0 0-3-3L5 16Z M14 7l3 3</StreamGeometry>
      <StreamGeometry x:Key="IconRename">M5 7h14 M12 7v12 M9 19h6</StreamGeometry>
      <StreamGeometry x:Key="IconMove">M4 8h13 M14 5l3 3-3 3 M20 16H7 M10 13l-3 3 3 3</StreamGeometry>
      <StreamGeometry x:Key="IconMore">M6 12h.01 M12 12h.01 M18 12h.01</StreamGeometry>
      <StreamGeometry x:Key="IconArrowLeft">M19 12H5 M11 6l-6 6 6 6</StreamGeometry>
      <StreamGeometry x:Key="IconArrowRight">M5 12h14 M13 6l6 6-6 6</StreamGeometry>
      <StreamGeometry x:Key="IconMinus">M5 12h14</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M6 15l6-6 6 6</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
      <StreamGeometry x:Key="IconUpload">M12 16V4 M7 9l5-5 5 5 M5 20h14</StreamGeometry>
      <StreamGeometry x:Key="IconSave">M5 3h12l4 4v14H3V3Z M7 3v6h10V3 M7 21v-8h10v8</StreamGeometry>
      <StreamGeometry x:Key="IconHistory">M3 11a9 9 0 1 1 2.6 7 M3 4v7h7 M12 7v5l3 2</StreamGeometry>
      <StreamGeometry x:Key="IconBook">M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5v-15Z M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3 M9 8h6 M9 12h6</StreamGeometry>
      <StreamGeometry x:Key="IconCart">M3 4h2.2l2 11h10.3l2-8H6.3 M9 20h.01 M17 20h.01</StreamGeometry>
      <StreamGeometry x:Key="IconActivity">M3 12h4l3-7 4 14 3-7h4</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, Arial" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Buttons: secondary by default; .primary-action, .ghost and .danger are the other variants -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /></Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45" /></Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="PlaceholderForeground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionTextBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBox:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="TextBox:not(:disabled) /template/ TextBlock#PART_Placeholder, ComboBox:not(:disabled) /template/ TextBlock">
    <!-- Fluent halves placeholder opacity; keep the chosen text contrast on dark inputs. -->
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="PlaceholderForeground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
  </Style>
  <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="True" /></Style>
</Styles>
